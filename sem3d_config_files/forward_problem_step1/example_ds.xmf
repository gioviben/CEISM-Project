<?xml version="1.0" ?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd">
<Xdmf Version="2.0" xmlns:xi="http://www.w3.org/2001/XInclude">
<Domain>
   <DataItem Name="ds" Format="HDF" DataType="Float" Precision="8" Dimensions="200 200 200">
        example_ds.h5:/Rho
   </DataItem>
  <Grid GridType="Collection" CollectionType="Spatial">
   <Grid Name="Group1">
     <Topology TopologyType="3DCoRectMesh" Dimensions="200 200 200"/>
     <Geometry GeometryType="ORIGIN_DXDYDZ">
   <DataItem Name="origin" Format="XML" DataType="Float" Precision="8" Dimensions="3">
                       -2000.0000000000
                       -2000.0000000000
                       -2000.0000000000
   </DataItem>
   <DataItem Name="step" Format="XML" DataType="Float" Precision="8" Dimensions="3">
                          11.3065326633
                          20.1005025126
                          20.1005025126
   </DataItem>
     </Geometry>
     <Attribute Name="ds" Center="Node" AttributeType="Scalar">
       <DataItem Reference="XML">
         /Xdmf/Domain/DataItem[@Name="ds"]
       </DataItem>
     </Attribute>
   </Grid>
  </Grid>
 </Domain>
</Xdmf>
